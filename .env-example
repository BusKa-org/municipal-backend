# .env
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DB_USER=buska_user
DB_PASSWORD=buska_pass
DB_HOST=db
DB_PORT=5432
DB_NAME=buska_db

# JWT
JWT_SECRET_KEY=super-secret-key-change-me
JWT_EXPIRES_HOURS=2

# CORS - Comma-separated list of allowed origins
# Leave empty or unset in development to allow all origins
# In production, set to your frontend URL(s)
# Example: https://app.buska.com,https://admin.buska.com
CORS_ORIGINS=
