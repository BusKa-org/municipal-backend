  "info": {
    "title": "BusKá API",
    "version": "1.0.0",
    "description": "\n## Sistema de Gerenciamento de Transporte Escolar\n\nAPI para gerenciamento de rotas, viagens e alunos do transporte escolar municipal.\n\n### Autenticação\nTodos os endpoints (exceto `/auth/login`) requerem autenticação JWT.\nInclua o header: `Authorization: Bearer <seu_token>`\n\n### Roles\n- **ALUNO**: Visualiza rotas, confirma presença em viagens\n- **MOTORISTA**: Gerencia viagens atribuídas, inicia/finaliza trajetos\n- **GESTOR**: Acesso completo à prefeitura (CRUD de rotas, motoristas, relatórios)\n        "
  },
  "produces": [
    "application/json"
  ],
  "consumes": [
    "application/json"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "JWT token. Format: Bearer <token>"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Autenticação e gerenciamento de sessão"
    },
    {
      "name": "users",
      "description": "Gerenciamento de Usuários e Perfil"
    },
    {
      "name": "onibus",
      "description": "Gerenciamento da Frota"
    },
    {
      "name": "rotas",
      "description": "Gestão de Rotas"
    },
    {
      "name": "pontos",
      "description": "Gestão de Infraestrutura Geográfica"
    },
    {
      "name": "viagens",
      "description": "Execução de Viagens"
    },
    {
      "name": "instituicoes",
      "description": "Gestão de Escolas e Instituições de Ensino"
    },
    {
      "name": "alunos",
      "description": "Área do Aluno (App)"
    }
  ],
