# -------------------------------------------------------
# BusKá Backend Environment Variables
# Copy this file to `.env` and adjust values as needed
# -------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=true

# -------------------------
# Database configuration
# -------------------------
# Used by Flask, Alembic and scripts

DB_HOST=localhost
DB_PORT=5432
DB_USER=buska_user
DB_PASSWORD=buska_pass
DB_NAME=buska_db

# -------------------------
# API configuration
# -------------------------

API_PORT=5000

# JWT
JWT_SECRET_KEY=change-this-secret-key
JWT_EXPIRES_HOURS=2

# -------------------------
# CORS configuration
# -------------------------
# Comma-separated list of allowed origins
# Leave empty in development to allow all origins
# Example:
# CORS_ORIGINS=https://app.buska.com,https://admin.buska.com

CORS_ORIGINS=

# -------------------------
# Rate limit (Flask-Limiter)
# -------------------------
# Where the counters live. memory:// counts separately in each gunicorn worker;
# redis://host:6379/0 shares one counter across all of them.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
# Format: "<n> per <second|minute|hour|day>"
RATELIMIT_DEFAULT=2000 per hour
RATELIMIT_AUTH=10 per minute
RATELIMIT_SENSITIVE=5 per minute
# Real-time GPS (many requests in a row from the same user)
RATELIMIT_REALTIME=120 per minute
